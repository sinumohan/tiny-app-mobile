{
  "expo": {
    "name": "TinyExperiments",
    "slug": "tiny-app-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FCF6E8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "me.tinyexperiments.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF6E8"
      },
      "package": "me.tinyexperiments.app"
    },
    "scheme": "tinyexperiments",
    "plugins": ["expo-router", "expo-font", "expo-secure-store"]
  }
}
